<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the bank keys go neither to cloud backup nor to a
     new device. See backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sb1_sync_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sb1_sync_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
